{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated student or admin profile in Exam Master Nigeria with subscription and referral tracking.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "provider": { "type": "string", "enum": ["email", "google"] },
        "phone": { "type": "string", "maxLength": 40 },
        "classLevel": { "type": "string", "maxLength": 40 },
        "targetExam": { "type": "string", "enum": ["JAMB", "WAEC", "NECO", "POST-UTME"] },
        "targetSchool": { "type": "string", "maxLength": 140 },
        "state": { "type": "string", "maxLength": 60 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "tier": { "type": "string", "enum": ["free", "premium"] },
        "plan": { "type": "string", "enum": ["free", "trial", "weekly", "premium", "season_pass"] },
        "planExpiry": { "type": "string", "maxLength": 64 },
        "trialUsed": { "type": "boolean" },
        "emailVerified": { "type": "boolean" },
        "onboarded": { "type": "boolean" },
        "dailyAiDate": { "type": "string", "maxLength": 20 },
        "dailyAiCount": { "type": "number" },
        "dailyCbtCount": { "type": "number" },
        "lastResetDate": { "type": "string", "maxLength": 20 },
        "referralCode": { "type": "string", "maxLength": 32 },
        "referredBy": { "type": "string", "maxLength": 128 },
        "referralCount": { "type": "number" },
        "referralBonusDays": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role", "tier", "onboarded", "createdAt"]
    },
    "Subscription": {
      "title": "Subscription",
      "description": "Server-verified Paystack card payment, manual bank transfer receipt, trial, referral bonus, or admin plan grant record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 160 },
        "userName": { "type": "string", "maxLength": 120 },
        "plan": { "type": "string", "enum": ["free", "trial", "weekly", "premium", "season_pass"] },
        "amount": { "type": "number" },
        "reference": { "type": "string", "maxLength": 128 },
        "channel": { "type": "string", "enum": ["card", "bank_transfer", "trial", "referral", "admin_grant"] },
        "status": { "type": "string", "enum": ["success", "failed", "pending", "rejected", "expired"] },
        "date": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "receiptUrl": { "type": "string", "maxLength": 1200 },
        "receiptPath": { "type": "string", "maxLength": 300 },
        "transferExpiresAt": { "type": "string", "format": "date-time" },
        "submittedAt": { "type": "string", "format": "date-time" },
        "rejectionReason": { "type": "string", "maxLength": 500 },
        "reviewedBy": { "type": "string", "maxLength": 160 },
        "reviewedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "plan", "amount", "reference", "channel", "status", "date"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "In-app payment approval or rejection notification owned by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "enum": ["payment_approved", "payment_rejected"] },
        "title": { "type": "string", "maxLength": 160 },
        "message": { "type": "string", "maxLength": 600 },
        "reference": { "type": "string", "maxLength": 128 },
        "plan": { "type": "string", "enum": ["free", "trial", "weekly", "premium", "season_pass"] },
        "reason": { "type": "string", "maxLength": 500 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "title", "message", "reference", "plan", "read", "createdAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted admin role marker document keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Nigerian secondary and UTME curriculum subject.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "slug": { "type": "string", "minLength": 1, "maxLength": 140 },
        "category": { "type": "string", "enum": ["Core", "Sciences", "Arts", "Commercial", "Trade/Technical", "JAMB", "JSS"] },
        "examTypes": { "type": "array" },
        "icon": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 600 }
      },
      "required": ["id", "name", "slug", "category", "examTypes", "icon", "description"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Nigerian examination body metadata (JAMB, WAEC, NECO, POST-UTME).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "enum": ["JAMB", "WAEC", "NECO", "POST-UTME"] },
        "name": { "type": "string", "maxLength": 100 },
        "fullName": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 600 },
        "maxScore": { "type": "number" },
        "defaultDurationMins": { "type": "number" }
      },
      "required": ["id", "code", "name", "fullName", "description", "maxScore", "defaultDurationMins"]
    },
    "Topic": {
      "title": "Topic",
      "description": "Syllabus topic linked to a subject and exam.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "subjectId": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 160 },
        "slug": { "type": "string", "maxLength": 160 },
        "examCode": { "type": "string", "maxLength": 20 }
      },
      "required": ["id", "subjectId", "name", "slug", "examCode"]
    },
    "Question": {
      "title": "Question",
      "description": "Past exam question with 4 options and worked explanation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "examId": { "type": "string", "maxLength": 128 },
        "examCode": { "type": "string", "enum": ["JAMB", "WAEC", "NECO", "POST-UTME"] },
        "subjectId": { "type": "string", "maxLength": 128 },
        "subjectName": { "type": "string", "maxLength": 120 },
        "topicId": { "type": "string", "maxLength": 128 },
        "year": { "type": "number" },
        "topic": { "type": "string", "maxLength": 160 },
        "passage": { "type": "string", "maxLength": 4000 },
        "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "options": { "type": "array" },
        "explanation": { "type": "string", "maxLength": 3000 },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "examId", "examCode", "subjectId", "subjectName", "year", "topic", "prompt", "options", "explanation", "difficulty", "createdAt"]
    },
    "Attempt": {
      "title": "Attempt",
      "description": "Completed CBT attempt owned by a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "examCode": { "type": "string", "enum": ["JAMB", "WAEC", "NECO", "POST-UTME"] },
        "subjectIds": { "type": "array" },
        "subjectNames": { "type": "array" },
        "questionIds": { "type": "array" },
        "answers": { "type": "array" },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "durationSeconds": { "type": "number" },
        "timeLimitSeconds": { "type": "number" }
      },
      "required": ["id", "userId", "examCode", "subjectIds", "subjectNames", "questionIds", "answers", "startedAt", "completedAt", "durationSeconds", "timeLimitSeconds"]
    },
    "Result": {
      "title": "Result",
      "description": "Scored CBT test summary owned by a student.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "attemptId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "examCode": { "type": "string", "enum": ["JAMB", "WAEC", "NECO", "POST-UTME"] },
        "rawCorrect": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "percentage": { "type": "number" },
        "jambScore": { "type": "number" },
        "subjectBreakdown": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "attemptId", "userId", "examCode", "rawCorrect", "totalQuestions", "percentage", "jambScore", "subjectBreakdown", "createdAt"]
    },
    "NewsPost": {
      "title": "NewsPost",
      "description": "Nigerian education news, cut-off marks, and admission updates.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "maxLength": 200 },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "category": { "type": "string", "enum": ["JAMB", "WAEC", "admissions", "cut-off marks", "scholarships"] },
        "summary": { "type": "string", "maxLength": 600 },
        "content": { "type": "array" },
        "author": { "type": "string", "maxLength": 120 },
        "publishedAt": { "type": "string", "maxLength": 40 },
        "readTimeMins": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "slug", "title", "category", "summary", "content", "author", "publishedAt", "readTimeMins", "imageUrl"]
    },
    "School": {
      "title": "School",
      "description": "Nigerian university, polytechnic, or college directory entry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 180 },
        "acronym": { "type": "string", "maxLength": 40 },
        "type": { "type": "string", "enum": ["University", "Polytechnic", "College of Education"] },
        "ownership": { "type": "string", "enum": ["Federal", "State", "Private"] },
        "state": { "type": "string", "maxLength": 60 },
        "city": { "type": "string", "maxLength": 80 },
        "utmeCutOff": { "type": "number" },
        "tuitionRange": { "type": "string", "maxLength": 120 },
        "courses": { "type": "array" },
        "website": { "type": "string", "maxLength": 300 },
        "email": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "name", "acronym", "type", "ownership", "state", "city", "utmeCutOff", "tuitionRange", "courses", "website", "email", "phone"]
    },
    "Scholarship": {
      "title": "Scholarship",
      "description": "Nigerian undergraduate or school-leaver scholarship listing.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "maxLength": 200 },
        "sponsor": { "type": "string", "maxLength": 160 },
        "amount": { "type": "string", "maxLength": 120 },
        "deadline": { "type": "string", "maxLength": 40 },
        "eligibility": { "type": "string", "maxLength": 600 },
        "level": { "type": "string", "maxLength": 80 },
        "link": { "type": "string", "maxLength": 400 },
        "status": { "type": "string", "enum": ["Open", "Closing Soon"] }
      },
      "required": ["id", "title", "sponsor", "amount", "deadline", "eligibility", "level", "link", "status"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Exam Master AI Tutor conversation session owned by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 180 },
        "subjectId": { "type": "string", "maxLength": 128 },
        "subjectName": { "type": "string", "maxLength": 120 },
        "examLevel": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "subjectName", "examLevel", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message inside an Exam Master AI Tutor session.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sessionId": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string", "maxLength": 12000 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "sessionId", "userId", "role", "content", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profiles, subscription plans, referrals, and daily usage counters."
    },
    "/subscriptions/{subscriptionId}": {
      "schema": { "$ref": "#/entities/Subscription" },
      "description": "Server-verified Paystack card payment, manual bank transfer receipt, trial, referral bonus, and admin plan grant records."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "In-app payment approval and rejection notifications owned by users."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Admin role assignment documents."
    },
    "/subjects/{subjectId}": {
      "schema": { "$ref": "#/entities/Subject" },
      "description": "All seeded Nigerian curriculum subjects."
    },
    "/exams/{examId}": {
      "schema": { "$ref": "#/entities/Exam" },
      "description": "Nigerian exam board definitions."
    },
    "/topics/{topicId}": {
      "schema": { "$ref": "#/entities/Topic" },
      "description": "Syllabus topics for each subject."
    },
    "/questions/{questionId}": {
      "schema": { "$ref": "#/entities/Question" },
      "description": "Past questions bank with options and explanations."
    },
    "/attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/Attempt" },
      "description": "Student CBT practice attempts."
    },
    "/results/{resultId}": {
      "schema": { "$ref": "#/entities/Result" },
      "description": "Student CBT scores and subject breakdowns."
    },
    "/newsPosts/{postId}": {
      "schema": { "$ref": "#/entities/NewsPost" },
      "description": "School news, JAMB/WAEC updates, and cut-off marks."
    },
    "/schools/{schoolId}": {
      "schema": { "$ref": "#/entities/School" },
      "description": "Nigerian universities, polytechnics, and colleges directory."
    },
    "/scholarships/{scholarshipId}": {
      "schema": { "$ref": "#/entities/Scholarship" },
      "description": "Scholarship opportunities for Nigerian students."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatSession" },
      "description": "AI Tutor conversation sessions."
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "AI Tutor conversation messages."
    }
  }
}
