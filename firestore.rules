rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'nexorastudios894@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // 3. Entity Validators
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'name', 'email', 'role', 'tier', 'onboarded', 'createdAt']) &&
        data.keys().hasOnly([
          'uid', 'name', 'email', 'provider', 'phone', 'classLevel',
          'targetExam', 'targetSchool', 'state', 'role', 'tier',
          'plan', 'planExpiry', 'trialUsed',
          'emailVerified', 'onboarded', 'dailyAiDate', 'dailyAiCount', 'dailyCbtCount', 'lastResetDate',
          'referralCode', 'referredBy', 'referralCount', 'referralBonusDays',
          'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        (!('provider' in data) || data.provider in ['email', 'google']) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 40)) &&
        (!('classLevel' in data) || (data.classLevel is string && data.classLevel.size() <= 40)) &&
        (!('targetExam' in data) || data.targetExam in ['JAMB', 'WAEC', 'NECO', 'POST-UTME']) &&
        (!('targetSchool' in data) || (data.targetSchool is string && data.targetSchool.size() <= 140)) &&
        (!('state' in data) || (data.state is string && data.state.size() <= 60)) &&
        data.role in ['student', 'admin'] &&
        data.tier in ['free', 'premium'] &&
        (!('plan' in data) || data.plan in ['free', 'trial', 'weekly', 'premium', 'season_pass']) &&
        (!('planExpiry' in data) || data.planExpiry == null || (data.planExpiry is string && data.planExpiry.size() <= 64)) &&
        (!('trialUsed' in data) || data.trialUsed is bool) &&
        (!('emailVerified' in data) || data.emailVerified is bool) &&
        data.onboarded is bool &&
        (!('dailyAiDate' in data) || (data.dailyAiDate is string && data.dailyAiDate.size() <= 20)) &&
        (!('dailyAiCount' in data) || (data.dailyAiCount is number && data.dailyAiCount >= 0 && data.dailyAiCount <= 500)) &&
        (!('dailyCbtCount' in data) || (data.dailyCbtCount is number && data.dailyCbtCount >= 0 && data.dailyCbtCount <= 500)) &&
        (!('lastResetDate' in data) || (data.lastResetDate is string && data.lastResetDate.size() <= 20)) &&
        (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 32)) &&
        (!('referredBy' in data) || data.referredBy == null || (data.referredBy is string && data.referredBy.size() <= 128)) &&
        (!('referralCount' in data) || (data.referralCount is number && data.referralCount >= 0 && data.referralCount <= 100000)) &&
        (!('referralBonusDays' in data) || (data.referralBonusDays is number && data.referralBonusDays >= 0 && data.referralBonusDays <= 100000)) &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidSubscription(data) {
      return data.keys().hasAll(['id', 'userId', 'plan', 'amount', 'reference', 'channel', 'status', 'date']) &&
        data.keys().hasOnly([
          'id', 'userId', 'userEmail', 'userName', 'plan', 'amount', 'reference',
          'channel', 'status', 'date', 'expiresAt',
          'receiptUrl', 'receiptPath', 'transferExpiresAt', 'submittedAt',
          'rejectionReason', 'reviewedBy', 'reviewedAt'
        ]) &&
        isValidId(data.id) &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 160)) &&
        (!('userName' in data) || (data.userName is string && data.userName.size() <= 120)) &&
        data.plan in ['free', 'trial', 'weekly', 'premium', 'season_pass'] &&
        data.amount is number && data.amount >= 0 && data.amount <= 1000000 &&
        data.reference is string && data.reference.size() > 0 && data.reference.size() <= 128 &&
        data.channel in ['card', 'bank_transfer', 'trial', 'referral', 'admin_grant'] &&
        data.status in ['success', 'failed', 'pending', 'rejected', 'expired'] &&
        data.date is string && data.date.size() <= 64 &&
        (!('expiresAt' in data) || data.expiresAt == null || (data.expiresAt is string && data.expiresAt.size() <= 64)) &&
        (!('receiptUrl' in data) || data.receiptUrl == null || (data.receiptUrl is string && data.receiptUrl.size() <= 1200)) &&
        (!('receiptPath' in data) || data.receiptPath == null || (data.receiptPath is string && data.receiptPath.size() <= 300)) &&
        (!('transferExpiresAt' in data) || data.transferExpiresAt == null || (data.transferExpiresAt is string && data.transferExpiresAt.size() <= 64)) &&
        (!('submittedAt' in data) || data.submittedAt == null || (data.submittedAt is string && data.submittedAt.size() <= 64)) &&
        (!('rejectionReason' in data) || data.rejectionReason == null || (data.rejectionReason is string && data.rejectionReason.size() <= 500)) &&
        (!('reviewedBy' in data) || data.reviewedBy == null || (data.reviewedBy is string && data.reviewedBy.size() <= 160)) &&
        (!('reviewedAt' in data) || data.reviewedAt == null || (data.reviewedAt is string && data.reviewedAt.size() <= 64));
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'userId', 'type', 'title', 'message', 'reference', 'plan', 'read', 'createdAt']) &&
        data.keys().hasOnly(['id', 'userId', 'type', 'title', 'message', 'reference', 'plan', 'reason', 'read', 'createdAt']) &&
        isValidId(data.id) &&
        data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
        data.type in ['payment_approved', 'payment_rejected'] &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 600 &&
        data.reference is string && data.reference.size() > 0 && data.reference.size() <= 128 &&
        data.plan in ['free', 'trial', 'weekly', 'premium', 'season_pass'] &&
        (!('reason' in data) || data.reason == null || (data.reason is string && data.reason.size() <= 500)) &&
        data.read is bool &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidSubject(data) {
      return data.keys().hasAll(['id', 'name', 'slug', 'category', 'examTypes', 'icon', 'description']) &&
        data.keys().hasOnly(['id', 'name', 'slug', 'category', 'examTypes', 'icon', 'description']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 140 &&
        data.category in ['Core', 'Sciences', 'Arts', 'Commercial', 'Trade/Technical', 'JAMB', 'JSS'] &&
        data.examTypes is list && data.examTypes.size() >= 1 && data.examTypes.size() <= 8 &&
        data.examTypes[0] is string &&
        data.icon is string && data.icon.size() <= 60 &&
        data.description is string && data.description.size() <= 600;
    }

    function isValidExam(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'fullName', 'description', 'maxScore', 'defaultDurationMins']) &&
        data.keys().hasOnly(['id', 'code', 'name', 'fullName', 'description', 'maxScore', 'defaultDurationMins']) &&
        isValidId(data.id) &&
        data.code in ['JAMB', 'WAEC', 'NECO', 'POST-UTME'] &&
        data.name is string && data.name.size() <= 100 &&
        data.fullName is string && data.fullName.size() <= 200 &&
        data.description is string && data.description.size() <= 600 &&
        data.maxScore is number && data.defaultDurationMins is number;
    }

    function isValidTopic(data) {
      return data.keys().hasAll(['id', 'subjectId', 'name', 'slug', 'examCode']) &&
        data.keys().hasOnly(['id', 'subjectId', 'name', 'slug', 'examCode']) &&
        isValidId(data.id) &&
        data.subjectId is string && data.subjectId.size() <= 128 &&
        data.name is string && data.name.size() <= 160 &&
        data.slug is string && data.slug.size() <= 160 &&
        data.examCode is string && data.examCode.size() <= 20;
    }

    function isValidQuestion(data) {
      return data.keys().hasAll(['id', 'examId', 'examCode', 'subjectId', 'subjectName', 'year', 'topic', 'prompt', 'options', 'explanation', 'difficulty', 'createdAt']) &&
        data.keys().hasOnly(['id', 'examId', 'examCode', 'subjectId', 'subjectName', 'topicId', 'year', 'topic', 'passage', 'prompt', 'options', 'explanation', 'difficulty', 'createdAt']) &&
        isValidId(data.id) &&
        data.examId is string && data.examId.size() <= 128 &&
        data.examCode in ['JAMB', 'WAEC', 'NECO', 'POST-UTME'] &&
        data.subjectId is string && data.subjectId.size() <= 128 &&
        data.subjectName is string && data.subjectName.size() <= 120 &&
        (!('topicId' in data) || (data.topicId is string && data.topicId.size() <= 128)) &&
        data.year is number && data.year >= 1980 && data.year <= 2035 &&
        data.topic is string && data.topic.size() <= 160 &&
        (!('passage' in data) || (data.passage is string && data.passage.size() <= 4000)) &&
        data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 2000 &&
        data.options is list && data.options.size() == 4 &&
        data.options[0] is map &&
        data.explanation is string && data.explanation.size() <= 3000 &&
        data.difficulty in ['easy', 'medium', 'hard'] &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidAttempt(data) {
      return data.keys().hasAll(['id', 'userId', 'examCode', 'subjectIds', 'subjectNames', 'questionIds', 'answers', 'startedAt', 'completedAt', 'durationSeconds', 'timeLimitSeconds']) &&
        data.keys().hasOnly(['id', 'userId', 'examCode', 'subjectIds', 'subjectNames', 'questionIds', 'answers', 'startedAt', 'completedAt', 'durationSeconds', 'timeLimitSeconds']) &&
        isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.examCode in ['JAMB', 'WAEC', 'NECO', 'POST-UTME'] &&
        data.subjectIds is list && data.subjectIds.size() >= 1 && data.subjectIds.size() <= 10 &&
        data.subjectIds[0] is string &&
        data.subjectNames is list && data.subjectNames.size() >= 1 && data.subjectNames.size() <= 10 &&
        data.subjectNames[0] is string &&
        data.questionIds is list && data.questionIds.size() >= 1 && data.questionIds.size() <= 200 &&
        data.questionIds[0] is string &&
        data.answers is list && data.answers.size() >= 1 && data.answers.size() <= 200 &&
        data.answers[0] is map &&
        data.startedAt is string && data.startedAt.size() <= 64 &&
        data.completedAt is string && data.completedAt.size() <= 64 &&
        data.durationSeconds is number && data.durationSeconds >= 0 &&
        data.timeLimitSeconds is number && data.timeLimitSeconds > 0;
    }

    function isValidResult(data) {
      return data.keys().hasAll(['id', 'attemptId', 'userId', 'examCode', 'rawCorrect', 'totalQuestions', 'percentage', 'jambScore', 'subjectBreakdown', 'createdAt']) &&
        data.keys().hasOnly(['id', 'attemptId', 'userId', 'examCode', 'rawCorrect', 'totalQuestions', 'percentage', 'jambScore', 'subjectBreakdown', 'createdAt']) &&
        isValidId(data.id) &&
        data.attemptId is string && data.attemptId.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.examCode in ['JAMB', 'WAEC', 'NECO', 'POST-UTME'] &&
        data.rawCorrect is number && data.rawCorrect >= 0 &&
        data.totalQuestions is number && data.totalQuestions > 0 &&
        data.percentage is number && data.percentage >= 0 && data.percentage <= 100 &&
        data.jambScore is number && data.jambScore >= 0 && data.jambScore <= 400 &&
        data.subjectBreakdown is list && data.subjectBreakdown.size() >= 1 && data.subjectBreakdown.size() <= 10 &&
        data.subjectBreakdown[0] is map &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidNewsPost(data) {
      return data.keys().hasAll(['id', 'slug', 'title', 'category', 'summary', 'content', 'author', 'publishedAt', 'readTimeMins', 'imageUrl']) &&
        data.keys().hasOnly(['id', 'slug', 'title', 'category', 'summary', 'content', 'author', 'publishedAt', 'readTimeMins', 'imageUrl']) &&
        isValidId(data.id) &&
        data.slug is string && data.slug.size() <= 200 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 240 &&
        data.category in ['JAMB', 'WAEC', 'admissions', 'cut-off marks', 'scholarships'] &&
        data.summary is string && data.summary.size() <= 600 &&
        data.content is list && data.content.size() >= 1 && data.content.size() <= 30 &&
        data.content[0] is string &&
        data.author is string && data.author.size() <= 120 &&
        data.publishedAt is string && data.publishedAt.size() <= 40 &&
        data.readTimeMins is number &&
        data.imageUrl is string && data.imageUrl.size() <= 500;
    }

    function isValidSchool(data) {
      return data.keys().hasAll(['id', 'name', 'acronym', 'type', 'ownership', 'state', 'city', 'utmeCutOff', 'tuitionRange', 'courses', 'website', 'email', 'phone']) &&
        data.keys().hasOnly(['id', 'name', 'acronym', 'type', 'ownership', 'state', 'city', 'utmeCutOff', 'tuitionRange', 'courses', 'website', 'email', 'phone']) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() <= 180 &&
        data.acronym is string && data.acronym.size() <= 40 &&
        data.type in ['University', 'Polytechnic', 'College of Education'] &&
        data.ownership in ['Federal', 'State', 'Private'] &&
        data.state is string && data.state.size() <= 60 &&
        data.city is string && data.city.size() <= 80 &&
        data.utmeCutOff is number &&
        data.tuitionRange is string && data.tuitionRange.size() <= 120 &&
        data.courses is list && data.courses.size() >= 1 && data.courses.size() <= 40 &&
        data.courses[0] is string &&
        data.website is string && data.website.size() <= 300 &&
        data.email is string && data.email.size() <= 160 &&
        data.phone is string && data.phone.size() <= 60;
    }

    function isValidScholarship(data) {
      return data.keys().hasAll(['id', 'title', 'sponsor', 'amount', 'deadline', 'eligibility', 'level', 'link', 'status']) &&
        data.keys().hasOnly(['id', 'title', 'sponsor', 'amount', 'deadline', 'eligibility', 'level', 'link', 'status']) &&
        isValidId(data.id) &&
        data.title is string && data.title.size() <= 200 &&
        data.sponsor is string && data.sponsor.size() <= 160 &&
        data.amount is string && data.amount.size() <= 120 &&
        data.deadline is string && data.deadline.size() <= 40 &&
        data.eligibility is string && data.eligibility.size() <= 600 &&
        data.level is string && data.level.size() <= 80 &&
        data.link is string && data.link.size() <= 400 &&
        data.status in ['Open', 'Closing Soon'];
    }

    function isValidChatSession(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'subjectName', 'examLevel', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'userId', 'title', 'subjectId', 'subjectName', 'examLevel', 'createdAt', 'updatedAt']) &&
        isValidId(data.id) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 180 &&
        (!('subjectId' in data) || (data.subjectId is string && data.subjectId.size() <= 128)) &&
        data.subjectName is string && data.subjectName.size() <= 120 &&
        data.examLevel is string && data.examLevel.size() <= 40 &&
        data.createdAt is string && data.createdAt.size() <= 64 &&
        data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidChatMessage(data) {
      return data.keys().hasAll(['id', 'sessionId', 'userId', 'role', 'content', 'createdAt']) &&
        data.keys().hasOnly(['id', 'sessionId', 'userId', 'role', 'content', 'createdAt']) &&
        isValidId(data.id) &&
        data.sessionId is string && data.sessionId.size() <= 128 &&
        data.userId is string && data.userId == request.auth.uid &&
        data.role in ['user', 'assistant'] &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 12000 &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      // Users can initialize their own profile ONLY on Free plan with zeroed counters; they cannot set paid plans or expiry.
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming()) &&
        incoming().uid == userId &&
        (
          isAdmin() ||
          (
            incoming().role == 'student' &&
            incoming().tier == 'free' &&
            (!('plan' in incoming()) || incoming().plan == 'free') &&
            (!('planExpiry' in incoming()) || incoming().planExpiry == null) &&
            (!('trialUsed' in incoming()) || incoming().trialUsed == false) &&
            (!('dailyAiCount' in incoming()) || incoming().dailyAiCount == 0) &&
            (!('dailyCbtCount' in incoming()) || incoming().dailyCbtCount == 0) &&
            (!('referralCount' in incoming()) || incoming().referralCount == 0) &&
            (!('referralBonusDays' in incoming()) || incoming().referralBonusDays == 0)
          )
        );
      // Users CANNOT edit their own plan, planExpiry, tier, trialUsed, daily counters, or referral credits. Only server/admin can.
      allow update: if isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'phone', 'classLevel', 'targetExam', 'targetSchool',
            'state', 'emailVerified', 'onboarded', 'updatedAt'
          ])
        )
      );
      allow delete: if isValidId(userId) && isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow get: if isValidId(subscriptionId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      // Only the server (Admin SDK) or verified admin can record or modify payment subscriptions.
      allow create, update: if isValidId(subscriptionId) && isAdmin() && isValidSubscription(incoming()) && incoming().id == subscriptionId;
      allow delete: if isValidId(subscriptionId) && isAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, delete: if isValidId(notificationId) && isAdmin() && (request.method == 'delete' || (isValidNotification(incoming()) && incoming().id == notificationId));
      allow update: if isValidId(notificationId) && isSignedIn() && isValidNotification(incoming()) && (
        isAdmin() ||
        (
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['read'])
        )
      );
    }

    match /admins/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list, write: if false;
    }

    match /subjects/{subjectId} {
      allow get: if isValidId(subjectId);
      allow list: if true;
      allow create, update: if isValidId(subjectId) && isAdmin() && isValidSubject(incoming()) && incoming().id == subjectId;
      allow delete: if isValidId(subjectId) && isAdmin();
    }

    match /exams/{examId} {
      allow get: if isValidId(examId);
      allow list: if true;
      allow create, update: if isValidId(examId) && isAdmin() && isValidExam(incoming()) && incoming().id == examId;
      allow delete: if isValidId(examId) && isAdmin();
    }

    match /topics/{topicId} {
      allow get: if isValidId(topicId);
      allow list: if true;
      allow create, update: if isValidId(topicId) && isAdmin() && isValidTopic(incoming()) && incoming().id == topicId;
      allow delete: if isValidId(topicId) && isAdmin();
    }

    match /questions/{questionId} {
      allow get: if isValidId(questionId);
      allow list: if true;
      allow create, update: if isValidId(questionId) && isAdmin() && isValidQuestion(incoming()) && incoming().id == questionId;
      allow delete: if isValidId(questionId) && isAdmin();
    }

    match /newsPosts/{postId} {
      allow get: if isValidId(postId);
      allow list: if true;
      allow create, update: if isValidId(postId) && isAdmin() && isValidNewsPost(incoming()) && incoming().id == postId;
      allow delete: if isValidId(postId) && isAdmin();
    }

    match /schools/{schoolId} {
      allow get: if isValidId(schoolId);
      allow list: if true;
      allow create, update: if isValidId(schoolId) && isAdmin() && isValidSchool(incoming()) && incoming().id == schoolId;
      allow delete: if isValidId(schoolId) && isAdmin();
    }

    match /scholarships/{scholarshipId} {
      allow get: if isValidId(scholarshipId);
      allow list: if true;
      allow create, update: if isValidId(scholarshipId) && isAdmin() && isValidScholarship(incoming()) && incoming().id == scholarshipId;
      allow delete: if isValidId(scholarshipId) && isAdmin();
    }

    match /attempts/{attemptId} {
      allow get: if isValidId(attemptId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(attemptId) && isSignedIn() && isValidAttempt(incoming()) && incoming().id == attemptId;
      allow update: if isValidId(attemptId) && isSignedIn() && isValidAttempt(incoming()) && (
        isAdmin() ||
        (existing().userId == request.auth.uid && incoming().userId == existing().userId && incoming().diff(existing()).affectedKeys().hasOnly(['answers']))
      );
      allow delete: if isValidId(attemptId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /results/{resultId} {
      allow get: if isValidId(resultId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(resultId) && isSignedIn() && isValidResult(incoming()) && incoming().id == resultId;
      allow update: if isValidId(resultId) && isAdmin() && isValidResult(incoming());
      allow delete: if isValidId(resultId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /chats/{chatId} {
      allow get: if isValidId(chatId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(chatId) && isSignedIn() && isValidChatSession(incoming()) && incoming().id == chatId;
      allow update: if isValidId(chatId) && isSignedIn() && isValidChatSession(incoming()) && (
        isAdmin() ||
        (
          existing().userId == request.auth.uid &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'subjectId', 'subjectName', 'examLevel', 'updatedAt'])
        )
      );
      allow delete: if isValidId(chatId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /messages/{messageId} {
      allow get: if isValidId(messageId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(messageId) && isSignedIn() && isValidChatMessage(incoming()) && incoming().id == messageId &&
        exists(/databases/$(database)/documents/chats/$(incoming().sessionId)) &&
        get(/databases/$(database)/documents/chats/$(incoming().sessionId)).data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isValidId(messageId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
